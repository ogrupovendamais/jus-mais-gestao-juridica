    {
      "parameters": {
        "jsCode": "// Processar resposta da API Datajud\nconst response = $input.all()[0].json;\nconst hits = response.hits?.hits || [];\n\nif (hits.length === 0) {\n  return [{\n    json: {\n      success: false,\n      message: 'Processo não encontrado',\n      data: null\n    }\n  }];\n}\n\n// Pegar o primeiro resultado\nconst processo = hits[0]._source;\n\n// Formatar dados do processo\nconst dadosFormatados = {\n  numeroProcesso: processo.numeroProcesso,\n  classe: processo.classe?.nome || 'Não informado',\n  tribunal: processo.tribunal || 'Não informado',\n  sistema: processo.sistema?.nome || 'Não informado',\n  formato: processo.formato?.nome || 'Não informado',\n  grau: processo.grau || 'Não informado',\n  assuntos: (processo.assuntos || []).map(assunto => ({\n    codigo: assunto.codigo,\n    nome: assunto.nome\n  })),\n  dataAjuizamento: processo.dataAjuizamento,\n  dataHoraUltimaAtualizacao: processo.dataHoraUltimaAtualizacao,\n  orgaoJulgador: {\n    codigo: processo.orgaoJulgador?.codigo,\n    nome: processo.orgaoJulgador?.nome || 'Não informado',\n    codigoMunicipioIBGE: processo.orgaoJulgador?.codigoMunicipioIBGE\n  },\n  nivelSigilo: processo.nivelSigilo || 0,\n  partes: (processo.partes || []).map(parte => ({\n    nome: parte.pessoa?.nome || 'Não informado',\n    tipo: parte.polo || 'Não informado'\n  })),\n  movimentos: (processo.movimentos || []).map(mov => ({\n    codigo: mov.codigo,\n    nome: mov.nome || 'Movimento não especificado',\n    dataHora: mov.dataHora,\n    complementosTabelados: mov.complementosTabelados || []\n  }))\n};\n\nreturn [{\n  json: {\n    success: true,\n    message: 'Processo encontrado com sucesso',\n    data: dadosFormatados\n  }\n}];"
      },
